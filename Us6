### 2. `BillingJobServiceImpl.java`

```java
package com.infy.GenPay.service.impl;

import com.infy.GenPay.dto.BillingJobDTO;
import com.infy.GenPay.entity.*;
import com.infy.GenPay.exception.GenPayException;
import com.infy.GenPay.repository.*;
import com.infy.GenPay.service.BillingJobService;
import com.infy.GenPay.service.InvoiceService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.*;

@Service
@RequiredArgsConstructor
@Slf4j
public class BillingJobServiceImpl implements BillingJobService {

    private final BillingJobRepository billingJobRepository;
    private final SubscriptionRepository subscriptionRepository;
    private final InvoiceService invoiceService;

    @Override
    @Transactional
    public BillingJobDTO runBillingJob() {
        LocalDate today = LocalDate.now();
        log.info("Billing job started for date: {}", today);

        // --- IDEMPOTENCY CHECK ---
        // Don't run if a job already completed today
        boolean alreadyRan = billingJobRepository
            .existsByScheduledDateAndStatus(today, BillingJob.Status.COMPLETED);
        if (alreadyRan) {
            log.warn("Billing job already completed for {}. Skipping.", today);
            throw new GenPayException("Billing job already ran for today.");
        }

        // Create billing job record
        BillingJob job = new BillingJob();
        job.setScheduledDate(today);
        job.setStatus(BillingJob.Status.RUNNING);
        job.setStartedAt(LocalDateTime.now());
        job.setSubscriptionsProcessed(0);
        job.setInvoicesGenerated(0);
        job.setTotalAmount(BigDecimal.ZERO);
        billingJobRepository.save(job);

        int processed = 0;
        int invoicesGenerated = 0;
        BigDecimal totalAmount = BigDecimal.ZERO;
        StringBuilder errorLog = new StringBuilder();

        // --- FETCH DUE SUBSCRIPTIONS ---
        // Only ACTIVE subscriptions whose next_billing_date is today
        List<Subscription> dueSubscriptions = subscriptionRepository
            .findByNextBillingDateAndStatusIn(
                today,
                List.of(Subscription.Status.ACTIVE)
                // SUSPENDED and CANCELLED are excluded per acceptance criteria
            );

        log.info("Found {} subscriptions due for billing.", dueSubscriptions.size());

        for (Subscription subscription : dueSubscriptions) {
            try {
                // --- GENERATE INVOICE (with tax & discount) ---
                Invoice invoice = invoiceService
                    .generateInvoice(subscription, job);

                totalAmount = totalAmount.add(invoice.getTotalAmount());
                invoicesGenerated++;

                // --- UPDATE NEXT BILLING DATE ---
                subscription.setNextBillingDate(
                    calculateNextBillingDate(subscription)
                );
                subscription.setCurrentMrr(invoice.getSubtotal());
                subscriptionRepository.save(subscription);

                processed++;

            } catch (Exception e) {
                log.error("Failed to bill subscription {}: {}",
                    subscription.getId(), e.getMessage());
                errorLog.append("SUB ")
                    .append(subscription.getId())
                    .append(": ")
                    .append(e.getMessage())
                    .append("\n");
            }
        }

        // --- FINALIZE JOB ---
        job.setStatus(errorLog.isEmpty()
            ? BillingJob.Status.COMPLETED
            : BillingJob.Status.FAILED);
        job.setCompletedAt(LocalDateTime.now());
        job.setSubscriptionsProcessed(processed);
        job.setInvoicesGenerated(invoicesGenerated);
        job.setTotalAmount(totalAmount);
        if (!errorLog.isEmpty()) {
            job.setErrorLog(errorLog.toString());
        }
        billingJobRepository.save(job);

        log.info("Billing job finished. Processed: {}, Invoices: {}, Total: {}",
            processed, invoicesGenerated, totalAmount);

        return mapToDTO(job);
    }

    @Override
    public BillingJobDTO triggerManually() {
        return runBillingJob(); // same logic, just called from controller
    }

    @Override
    public BillingJobDTO getBillingJob(UUID id) {
        return billingJobRepository.findById(id)
            .map(this::mapToDTO)
            .orElseThrow(() -> new GenPayException("Billing job not found: " + id));
    }

    @Override
    public List<BillingJobDTO> getAllJobs() {
        return billingJobRepository.findAllByOrderByScheduledDateDesc()
            .stream().map(this::mapToDTO).toList();
    }

    // --- HELPERS ---

    private LocalDate calculateNextBillingDate(Subscription sub) {
        LocalDate current = sub.getNextBillingDate();
        return switch (sub.getBillingCycle()) {
            case MONTHLY   -> current.plusMonths(1);
            case QUARTERLY -> current.plusMonths(3);
            case ANNUAL    -> current.plusYears(1);
            case USAGE_BASED, PER_SEAT -> current.plusMonths(1); // default monthly
            default        -> current.plusMonths(1);
        };
    }

    private BillingJobDTO mapToDTO(BillingJob job) {
        BillingJobDTO dto = new BillingJobDTO();
        dto.setId(job.getId());
        dto.setScheduledDate(job.getScheduledDate());
        dto.setStatus(job.getStatus().name());
        dto.setStartedAt(job.getStartedAt());
        dto.setCompletedAt(job.getCompletedAt());
        dto.setSubscriptionsProcessed(job.getSubscriptionsProcessed());
        dto.setInvoicesGenerated(job.getInvoicesGenerated());
        dto.setTotalAmount(job.getTotalAmount());
        dto.setErrorLog(job.getErrorLog());
        return dto;
    }
}
