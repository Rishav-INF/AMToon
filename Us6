### 3. `InvoiceServiceImpl.java` (core generation logic)

```java
package com.infy.GenPay.service.impl;

import com.infy.GenPay.entity.*;
import com.infy.GenPay.repository.*;
import com.infy.GenPay.service.InvoiceService;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

@Service
@RequiredArgsConstructor
public class InvoiceServiceImpl implements InvoiceService {

    private final InvoiceRepository invoiceRepository;
    private final InvoiceLineItemRepository lineItemRepository;
    private final SubscriptionAddonRepository addonRepository;
    private final SubscriptionDiscountRepository subDiscountRepository;
    private final TaxRuleRepository taxRuleRepository;

    @Override
    @Transactional
    public Invoice generateInvoice(Subscription subscription,
                                   BillingJob job) {

        // --- IDEMPOTENCY: skip if invoice already exists for this
        //     subscription + billing period ---
        boolean exists = invoiceRepository
            .existsBySubscriptionIdAndBillingJobId(
                subscription.getId(), job.getId());
        if (exists) {
            return invoiceRepository
                .findBySubscriptionIdAndBillingJobId(
                    subscription.getId(), job.getId());
        }

        Plan plan = subscription.getPlan();
        Customer customer = subscription.getCustomer();

        // --- BUILD INVOICE ---
        Invoice invoice = new Invoice();
        invoice.setSubscription(subscription);
        invoice.setBillingJob(job);
        invoice.setInvoiceNumber(generateInvoiceNumber());
        invoice.setIssueDate(LocalDate.now());
        invoice.setDueDate(LocalDate.now().plusDays(7)); // net-7
        invoice.setStatus(Invoice.Status.DRAFT);

        // 1. Base plan price
        BigDecimal subtotal = plan.getBasePrice()
            .multiply(BigDecimal.valueOf(subscription.getQuantity()));

        // Line item: base plan
        InvoiceLineItem planLine = new InvoiceLineItem();
        planLine.setInvoice(invoice);
        planLine.setDescription(plan.getName() + " Plan");
        planLine.setQuantity(subscription.getQuantity());
        planLine.setUnitPrice(plan.getBasePrice());
        planLine.setLineTotal(subtotal);

        // 2. Add-ons
        List<SubscriptionAddon> addons = addonRepository
            .findBySubscriptionId(subscription.getId());
        BigDecimal addonTotal = BigDecimal.ZERO;
        for (SubscriptionAddon addon : addons) {
            BigDecimal lineTotal = addon.getPrice()
                .multiply(BigDecimal.valueOf(addon.getQuantity()));
            addonTotal = addonTotal.add(lineTotal);

            InvoiceLineItem addonLine = new InvoiceLineItem();
            addonLine.setInvoice(invoice);
            addonLine.setDescription(addon.getAddonName());
            addonLine.setQuantity(addon.getQuantity());
            addonLine.setUnitPrice(addon.getPrice());
            addonLine.setLineTotal(lineTotal);
            lineItemRepository.save(addonLine);
        }
        subtotal = subtotal.add(addonTotal);

        // 3. Apply discount (if any active discount on this subscription)
        BigDecimal discountAmount = BigDecimal.ZERO;
        List<SubscriptionDiscount> discounts = subDiscountRepository
            .findActiveBySubscriptionId(
                subscription.getId(), LocalDate.now());
        for (SubscriptionDiscount sd : discounts) {
            Discount d = sd.getDiscount();
            if (d.getDiscountType() == Discount.Type.PERCENTAGE) {
                discountAmount = discountAmount.add(
                    subtotal.multiply(d.getValue())
                        .divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP)
                );
            } else { // FLAT
                discountAmount = discountAmount.add(d.getValue());
            }
        }
        // Discount cannot exceed subtotal
        discountAmount = discountAmount.min(subtotal);

        // 4. Apply tax
        BigDecimal taxableAmount = subtotal.subtract(discountAmount);
        BigDecimal taxAmount = BigDecimal.ZERO;
        TaxRule taxRule = taxRuleRepository
            .findActiveByRegion(customer.getRegion()); // customer must have region
        if (taxRule != null && taxRule.isActive()) {
            taxAmount = taxableAmount
                .multiply(taxRule.getRate())
                .setScale(2, RoundingMode.HALF_UP);

            InvoiceLineItem taxLine = new InvoiceLineItem();
            taxLine.setInvoice(invoice);
            taxLine.setDescription("Tax (" + taxRule.getName()
                + " " + taxRule.getRate().multiply(
                    BigDecimal.valueOf(100)) + "%)");
            taxLine.setQuantity(1);
            taxLine.setUnitPrice(taxAmount);
            taxLine.setLineTotal(taxAmount);
            lineItemRepository.save(taxLine);
        }

        // 5. Final totals
        BigDecimal totalAmount = taxableAmount.add(taxAmount);

        invoice.setSubtotal(subtotal);
        invoice.setDiscountAmount(discountAmount);
        invoice.setTaxAmount(taxAmount);
        invoice.setTotalAmount(totalAmount);

        invoiceRepository.save(invoice);
        lineItemRepository.save(planLine);

        return invoice;
    }

    private String generateInvoiceNumber() {
        // Format: INV-YYYYMM-XXXXX
        String datePart = LocalDate.now().toString().substring(0, 7)
            .replace("-", "");
        String random = String.valueOf((int)(Math.random() * 90000) + 10000);
        return "INV-" + datePart + "-" + random;
    }
}
