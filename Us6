### 4. `BillingScheduler.java`

```java
package com.infy.GenPay.scheduler;

import com.infy.GenPay.service.BillingJobService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.EnableScheduling;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

@Component
@EnableScheduling
@RequiredArgsConstructor
@Slf4j
public class BillingScheduler {

    private final BillingJobService billingJobService;

    // Runs every day at midnight
    @Scheduled(cron = "0 0 0 * * *")
    public void runDailyBilling() {
        log.info("=== Daily Billing Scheduler Triggered ===");
        try {
            billingJobService.runBillingJob();
        } catch (Exception e) {
            // Catch here so scheduler thread doesn't die on error
            log.error("Billing scheduler failed: {}", e.getMessage());
        }
    }
}
